[Desktop Entry]
Type=Application
Name=IAO
Comment=Gestionnaire de comptes et sessions IA
Comment[fr]=Gestionnaire de comptes et sessions IA
Exec=@EXEC@
Icon=@ICON@
Terminal=false
Categories=Network;Utility;Office;
StartupWMClass=IAO
StartupNotify=true
Actions=debug;

# Issue #162 : clic droit sur l'icône -> lancement avec journal détaillé.
[Desktop Action debug]
Name=IAO (mode debug)
Exec=@EXEC@ --debug
