msgstr "Vælg en fil for at redigere den her."

#: assets/app.js
msgid "Éditeur simplifié (Monaco indisponible) — Ctrl+S pour sauvegarder"
msgstr "Forenklet editor (Monaco utilgængelig) — Ctrl+S for at gemme"

#: assets/app.js
msgid "Fichier enregistré !"
