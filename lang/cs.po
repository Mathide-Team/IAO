msgstr "Aktualizované služby ({count} / {max})"

#: assets/app.js
msgid "Supprimer « {name} » ({email}) ? La session restera stockée sur le disque, mais le compte disparaîtra de la liste."
msgstr "Smazat \"{name}\" ({email})? Relace zůstane uložena na disku, ale účet zmizí ze seznamu."

